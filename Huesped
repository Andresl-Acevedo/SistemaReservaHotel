package sistema_de_reservas_de_hotel;

public class Huesped {
    private String nombre;
    private Reserva reserva;

    public Huesped(String nombre) {
        this.nombre = nombre;
    }

    public String getNombre() {
        return nombre;
    }

    public Reserva getReserva() {
        return reserva;
    }

    public void realizarReserva(Habitacion habitacion, String fechaEntrada, String fechaSalida) {
        reserva = new Reserva(this, habitacion, fechaEntrada, fechaSalida);
    }
    public void eliminarReserva() {
        reserva = null;
    }
}
